<?xml version="1.0" encoding="utf-8"?>
<!--
    Lumora mark: an amber lens with a play symbol, a soft halo ring and a mint spark.
    Drawn on the 108dp adaptive-icon grid; everything stays inside the 66dp safe zone so
    launcher masks and the splash screen circle never clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Halo ring -->
    <path
        android:pathData="M23,54 a31,31 0 1,1 62,0 a31,31 0 1,1 -62,0 z"
        android:strokeWidth="2.5"
        android:strokeColor="#59FFB45C" />

    <!-- Lens -->
    <path android:pathData="M30,54 a24,24 0 1,1 48,0 a24,24 0 1,1 -48,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="37"
                android:startY="37"
                android:endX="71"
                android:endY="71">
                <item android:offset="0" android:color="#FFFFCB80" />
                <item android:offset="1" android:color="#FFFF8F3A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Play symbol with rounded corners, nudged right to look optically centred -->
    <path
        android:fillColor="#FF2B1700"
        android:pathData="M49,44.6 Q49,41.6 51.6,43.3 L65.1,52.3 Q67.6,54 65.1,55.7 L51.6,64.7 Q49,66.4 49,63.4 Z" />

    <!-- Spark on the halo -->
    <path
        android:fillColor="#FF8FD6C9"
        android:pathData="M73.4,32.1 a2.8,2.8 0 1,1 5.6,0 a2.8,2.8 0 1,1 -5.6,0 z" />
</vector>
